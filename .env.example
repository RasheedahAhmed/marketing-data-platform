# Set these in the shell; do not commit real values.
DBT_HOST=your-workspace-hostname-without-https
DBT_HTTP_PATH=/sql/1.0/warehouses/YOUR_WAREHOUSE_ID
DBT_CATALOG=marketing_dev
DBT_SCHEMA=dev_rasheedah
BRONZE_CATALOG=marketing_dev
BRONZE_SCHEMA=bronze
# CI/staging/production: Databricks OAuth service-principal credentials.
DATABRICKS_CLIENT_ID=YOUR_APPLICATION_ID
DBT_ENV_SECRET_DATABRICKS_CLIENT_SECRET=YOUR_DATABRICKS_OAUTH_SECRET
